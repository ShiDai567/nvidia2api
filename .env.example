# ===== 基础 =====
# 生产环境务必修改为随机长字符串（openssl rand -hex 32）
SECRET_KEY=change-me-to-a-random-string
DEBUG=false

DATA_DIR=./data
DATABASE_PATH=./data/db.sqlite3

# ===== 管理后台 =====
# 生产环境务必修改！默认值仅供首次启动
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Admin API 令牌（登录后返回该 Token；也作为默认 Bearer）
ADMIN_TOKEN=dev-admin-token

# ===== 上游 NVIDIA =====
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# 单个 NVIDIA Key 默认 RPM（可在设置页按 Key 修改）
DEFAULT_NVIDIA_RPM=40

# ===== 并发与超时 =====
MAX_CONCURRENT_REQUESTS=100
MAX_ROUTES_PER_REQUEST=50

PROXY_TIMEOUT=10
UPSTREAM_CONNECT_TIMEOUT=10
UPSTREAM_READ_TIMEOUT=120

LOG_LEVEL=INFO

# ===== CORS =====
# 留空 = 允许所有来源（默认部署为同源反代，通常无需配置）。
# 如后端单独暴露给其他前端，请显式列出来源，逗号分隔：
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://console.example.com

# ===== 前端 =====
# 默认同源（Next.js rewrites 反代 /api 与 /v1），本地前后端分离开发时才需要设置
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
